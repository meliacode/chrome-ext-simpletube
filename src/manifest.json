{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.12.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["i18n.js", "content.js", "contentCategorize.js"],
      "css": ["content.css", "contentCategorize.css"],
      "run_at": "document_idle"
    }
  ]
}
